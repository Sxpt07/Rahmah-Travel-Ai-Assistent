# ===== Server lokal =====
PORT=3000
NODE_ENV=development

# ===== AI (Gemini) =====
AI_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
# Model Gemini utama + fallback otomatis (pisahkan fallback dengan koma).
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash,gemini-flash-latest
GEMINI_TIMEOUT_MS=6000
# Timeout khusus Rapihin Kata (teks FU bisa panjang).
GEMINI_POLISH_TIMEOUT_MS=25000

# ===== SGO Admin (single-user lokal) =====
# Cookie sesi disimpan per-device sebagai HttpOnly cookie lewat tombol Cookie SGO di UI.
# Tidak ada fallback cookie dari .env.
SGO_BASE_URL=https://sgo.rahmahgrup.id
SGO_REQUEST_TIMEOUT_MS=20000
# Pool permintaan halaman paralel: 1-10 (default 8).
SGO_PAGE_CONCURRENCY=8
# Worker validasi manifest paralel: 1-16 (default 8).
SGO_MANIFEST_CONCURRENCY=8
# Retry transien (timeout / 429 / 5xx) dengan exponential backoff.
SGO_HTTP_RETRY_ATTEMPTS=4
SGO_HTTP_RETRY_BASE_MS=1200
SGO_HTTP_RETRY_MAX_MS=10000
# Parameter pagination Upload Manifest.
SGO_PAGE_PARAM=page
SGO_UPLOAD_SEARCH=ORD
# Folder respons mentah SGO (berisi PII, jangan di-commit).
SGO_RAW_DIR=sgo_raw
SGO_MANIFEST_TIMEOUT_MS=20000
SGO_MANIFEST_CACHE_MS=300000

# ===== Data lokal =====
# JAMAAH_DATA_FILE=jamaah_data.json
# JAMAAH_AI_INDEX_FILE=data/jamaah_ai_index.json

# ===== Scraper =====
SCRAPER_MAX_CHARS=30000
SCRAPER_TIMEOUT_MS=20000
